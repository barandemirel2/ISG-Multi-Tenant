REACT_APP_BACKEND_URL=http://localhost:8000

# --- Public registration UX gate (P0) ---
# Build-time (CRA / CRACO) mirror of the backend
# ``ENABLE_PUBLIC_REGISTRATION``. Default is closed (the registration
# link is not rendered, ``/register`` redirects to ``/login``). Only an
# explicit "true" enables the surface in this build. Strict parser:
# canonical literals only. The backend gate is the authoritative
# security boundary; this flag is UX-only. See ``ARRODES.md`` →
# "Public registration gate".
# REACT_APP_PUBLIC_REGISTRATION_ENABLED=false
