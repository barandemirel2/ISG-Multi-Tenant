# Railway UAT — environment example (PLACEHOLDERS ONLY)
#
# This file is a SAFE template. No real secrets, no real Railway domain,
# no real Mongo URI. Copy it into Railway's variable editor (per-service)
# and replace each placeholder before deploying.
#
# BACKEND RUNTIME VARIABLES (FastAPI service)
# ─────────────────────────────────────────────────────────────────────
# Railway injects PORT automatically (used by the uvicorn CMD and the
# HEALTHCHECK). Do not override PORT manually.

# Required at startup. The backend refuses to boot if either is missing.
MONGO_URL=
DB_NAME=risk_analiz_uat

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Admin bootstrap (first deploy seeds the admin user).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cookie / CORS contract for the cross-site Railway frontend.
# COOKIE_SECURE must be true when COOKIE_SAMESITE=none (browsers reject
# SameSite=None cookies without Secure).
# CORS_ORIGINS must be the EXACT frontend origin (no trailing slash) the
# browser will use; Railway issues HTTPS by default.
CORS_ORIGINS=
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Disables /docs, /redoc, /openapi.json on the public backend. Defaults
# to true (local dev keeps Swagger). Set to false on Railway.
DOCS_ENABLED=false

# Public registration gate (P0). Production posture is CLOSED. The
# frontend mirror flag is listed below under "FRONTEND BUILD-TIME
# VARIABLE". Strict parser: canonical literals only. The backend flag
# is the authoritative security boundary — even if the frontend flag
# is enabled, this flag must be "true" for ``POST /api/auth/register``
# to accept requests. See ``ARRODES.md`` → "Public registration gate".
ENABLE_PUBLIC_REGISTRATION=false

# Public origin used to build the verification link embedded in the
# QR code in PDF exports. Set to the EXACT backend HTTPS origin
# Railway assigns (no trailing slash).
VERIFICATION_BASE_URL=

# ─────────────────────────────────────────────────────────────────────
# FRONTEND RUNTIME VARIABLE (nginx reverse proxy — STARTUP-SAFETY ONLY)
# ─────────────────────────────────────────────────────────────────────
# Target of the in-tree nginx ``/api/`` reverse proxy (``proxy_pass``).
# Default baked into the image = ``http://backend:8000`` (docker-compose
# in-network service name). On Railway the frontend is a standalone
# service, so the operator MUST override this — otherwise nginx fails to
# start with ``host not found in upstream "backend"``.
#
# The documented Railway UAT mode, locally verified in isolated Docker,
# is split-host browser-direct API traffic:
#
#   BACKEND_UPSTREAM=http://127.0.0.1:9999
#
# The /api/ reverse proxy is dormant in that mode — the React bundle
# calls the absolute backend origin baked at ``npm run build`` time via
# ``REACT_APP_BACKEND_URL``. The placeholder value exists ONLY so nginx
# can resolve an upstream name at container start; the proxy itself
# never serves Railway browser traffic.
#
# Do NOT bake a real production domain into source control.
BACKEND_UPSTREAM=http://127.0.0.1:9999

# ─────────────────────────────────────────────────────────────────────
# FRONTEND BUILD-TIME VARIABLE (CRA / CRACO)
# ─────────────────────────────────────────────────────────────────────
# REACT_APP_BACKEND_URL is consumed at `npm run build` time. Changing
# it requires a FRONTEND REBUILD.
#
# The documented Railway UAT mode, locally verified in isolated Docker —
# split-host browser-direct:
#
#   REACT_APP_BACKEND_URL=https://<backend-public-origin>
#
# The browser hits the backend directly. The in-tree nginx /api/ proxy
# is dormant in this mode. A frontend rebuild is required whenever
# this value changes (CRA build-time injection).
#
# DO NOT commit a real Railway / production URL to source. Replace
# ``<backend-public-origin>`` with the HTTPS origin Railway assigns to
# the backend service at deploy time.
#
# Local docker-compose default (NOT for Railway):
#   REACT_APP_BACKEND_URL=http://localhost:8000
#
# Public registration UX mirror (P0). Build-time (CRA / CRACO).
# Default is closed (the "Hesap Oluştur" link is not rendered and
# ``/register`` redirects to ``/login``). The backend
# ``ENABLE_PUBLIC_REGISTRATION`` is the authoritative security
# boundary — this flag is UX-only. See ``ARRODES.md`` → "Public
# registration gate".
# REACT_APP_PUBLIC_REGISTRATION_ENABLED=false
#
# ─────────────────────────────────────────────────────────────────────
# NOT PART OF THIS UAT DEPLOYMENT / NOT VALIDATED HERE
# ─────────────────────────────────────────────────────────────────────
# Same-origin reverse-proxying via nginx to a Railway backend hostname
# (BACKEND_UPSTREAM=http://<backend-service>.up.railway.app together
# with REACT_APP_BACKEND_URL=/api) is a possible FUTURE architecture.
# It has NOT been validated in this patch. Railway private-network
# DNS, public-network DNS, and HTTPS host-header routing through the
# in-tree proxy are not exercised by the isolated-startup proof in
# this patch and are not part of the UAT contract.
#
# Use only the split-host mode documented above unless that work is
# done explicitly.
# ─────────────────────────────────────────────────────────────────────
REACT_APP_BACKEND_URL=https://<backend-public-origin>
