# Bu dosyayı backend/.env olarak kopyala:
#   cp backend/.env.example backend/.env
# (Docker kullanıyorsan bunun yerine kök .env kullanılır; uvicorn'u doğrudan host'tan çalıştırıyorsan bu dosya gerekli.)

MONGO_URL=mongodb://localhost:27017
DB_NAME=risk_analiz

# --- ZORUNLU, fail-fast ---
# Üret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-with-the-command-above-min-32-chars

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_VALUE_AT_LEAST_16_CHARS

# --- Cookie security policy (PR4) ---
# Both variables are required at startup. The backend refuses to start when
# either is missing, malformed, or forms an invalid combination
# (e.g. COOKIE_SAMESITE=none with COOKIE_SECURE=false).
#
# COOKIE_SECURE: only the canonical boolean literal is accepted:
#   true | false   (case-insensitive, surrounding whitespace tolerated).
#   Aliases such as 1/0, yes/no, on/off are deliberately rejected.
# COOKIE_SAMESITE: lax|strict|none (case-insensitive). "none" requires
# COOKIE_SECURE=true.
#
# Local HTTP Docker demo only (http://127.0.0.1, http://localhost):
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
#
# Real HTTPS deployment (TLS termination in front of the backend):
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
#
# Tokens remain HttpOnly in every profile.

# --- Opsiyonel ---
# JWT_ALGORITHM=HS256
# CORS_ORIGINS=http://localhost:3000
# ACCESS_TOKEN_TTL_MIN=720
# REFRESH_TOKEN_TTL_DAYS=7

# --- Public registration gate (P0) ---
# Production/default posture is CLOSED: unset / empty / "false" makes
# ``POST /api/auth/register`` return 404. Only an explicit "true"
# enables public account creation. Strict parser: only canonical
# literals (case-insensitive, surrounding whitespace tolerated).
# Aliases such as 1/0/yes/no are rejected. See ``ARRODES.md`` →
# "Public registration gate" and ``backend/registration_config.py``.
# ENABLE_PUBLIC_REGISTRATION=false
