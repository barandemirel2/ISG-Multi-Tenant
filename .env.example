# Bu dosyayı `.env` olarak kopyala ve değerleri güncelle:
#   cp .env.example .env

# --- ZORUNLU, fail-fast ---
# JWT_SECRET: en az 32 karakter, rastgele. Üret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-with-the-command-above-min-32-chars

# Admin hesabı. İlk çalıştırmada DB'ye seed edilir.
# Admin e-postası benzersiz ve gerçek bir adres olmalı.
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD: en az 8 karakter, varsayılan/öngörülebilir değer KULLANMA.
ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_VALUE_AT_LEAST_16_CHARS

# --- Cookie security policy (PR4) ---
# Authentication cookies are emitted with the attributes derived from these
# two variables. Both are required at startup; invalid combinations fail
# fast (the backend refuses to start until they are corrected).
#
# COOKIE_SECURE: only the canonical boolean literal is accepted:
#   true | false   (case-insensitive, surrounding whitespace tolerated).
#   Aliases such as 1/0, yes/no, on/off are deliberately rejected.
# COOKIE_SAMESITE: lax|strict|none (case-insensitive). "none" requires
# COOKIE_SECURE=true; browsers reject SameSite=None without Secure.
#
# Local HTTP Docker demo only (http://127.0.0.1, http://localhost):
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
#
# Real HTTPS deployment (TLS termination in front of the backend):
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
#
# Tokens remain HttpOnly in every profile; no value is ever exposed via
# client-readable storage.

# --- Public registration gate (P0) ---
# Production/default posture is CLOSED: unset / empty / "false" makes
# ``POST /api/auth/register`` return 404. Only an explicit "true" enables
# public account creation. Aliases such as 1/0/yes/no are rejected.
# See ``ARRODES.md`` → "Public registration gate" for the security
# invariant and ``backend/registration_config.py`` for the strict
# parser contract.
#
# Frontend mirror flag (build-time, baked by CRA / CRACO):
#   REACT_APP_PUBLIC_REGISTRATION_ENABLED=false|true
# This is UX-only — the backend ``ENABLE_PUBLIC_REGISTRATION`` is the
# authoritative security boundary.

# --- Opsiyonel, varsayılanları kullanmak için boş bırakılabilir ---
# DB_NAME=risk_analiz
# JWT_ALGORITHM=HS256
# CORS_ORIGINS=http://localhost:3000
# ENABLE_PUBLIC_REGISTRATION=false
# REACT_APP_PUBLIC_REGISTRATION_ENABLED=false
